yt-dlp: Inst.  # sudo pacman -S yt-dlp
yt-dlp: Inst.  # scoop install yt-dlp
yt-dlp: List available  # yt-dlp -F "<url_1>"
yt-dlp: List playlist  # yt-dlp --flat-playlist --print "%(webpage_url)s" "<url>"
yt-dlp: Download  # yt-dlp -f "<video_id>+<audio_id>" "<url_1>"
yt-dlp: Download the best  # yt-dlp -f bestvideo+bestaudio "<url_1>"
yt-dlp: Download as MP3  # yt-dlp -x --audio-format mp3 --audio-quality 320k -o "%(title)s.%(ext)s" "<url_1>"
yt-dlp: Download subtitle  # yt-dlp --skip-download --write-auto-subs --sub-langs en --convert-subs srt --no-check-certificate "<url>"
