FFmpeg: Inst.  # sudo pacman -S ffmpeg
FFmpeg: Inst.  # scoop install ffmpeg-share
FFmpeg: Convert AAC to MP3  # ffmpeg -i "$1" -codec:a libmp3lame -qscale:a 1 _.mp3
FFmpeg: Convert FLAC to M4B  # ffmpeg -i "$1.flac" -c:a aac -b:a 128k -minrate 64k -maxrate 192k -ar 44100 _.m4b
FFmpeg: Convert FLACs to one MP3 1.  # find . -maxdepth 1 -type f -name '*.flac' | sort | sed "s | ^\./\(.*\)$ | file '\1' | " > _.txt
FFmpeg: Convert FLACs to one MP3 2.  # ffmpeg -f concat -safe 0 -i _.txt -codec:a libmp3lame -qscale:a 1 _.mp3
## https://gist.github.com/gvoze32/95f96992a443e73c4794c342a44e0811
FFmpeg: Convert GIF/APNG to MP4  # ffmpeg -i "$1.gif/apng" -movflags faststart -pix_fmt yuv420p -vf "fps=30,scale=trunc(iw/2)*2:trunc(ih/2)*2" -c:v libx264 -crf 23 -preset veryslow _.mp4
FFmpeg: Convert M4A to MP3  # ffmpeg -i "$1" -vn -c:a libmp3lame -b:a 224K -ac 2 _.mp3
FFmpeg: Convert WAVs/FLACs/M4As to MP3  # find . -type f \( -iname "*.wav" -o -iname "*.flac" -o -iname "*.m4a" \) -print0 | xargs -0 -I {} ffmpeg -i "{}" -c:a libmp3lame -ar 44100 -b:a 256k -maxrate 320k -minrate 128k -bufsize 320k "{.}.mp3"
FFmpeg: Convert audio to OGG for music  # ffmpeg -i "$1" -c:a libvorbis -ar 44100 -b:a 256k -maxrate 320k -minrate 128k -bufsize 320k _.ogg
FFmpeg: Convert audio to OGG for voice  # ffmpeg -i "$1" -c:a libvorbis -ar 44100 -b:a 128k -maxrate 192k -minrate 64k -bufsize 192k _.ogg
FFmpeg: Convert audio to OGG  # ffmpeg -i "$1" -map_metadata -1 -c:a libvorbis -b:a 64k -compression_level 10 -vn _.ogg
FFmpeg: Convert audio to optimized M4B  # ffmpeg -i "$1" -map 0:a -map_metadata 0 -c:a aac -b:a 64k -id3v2_version 3 -movflags +faststart _opti.m4b
FFmpeg: Convert video to MP4  # ffmpeg -i "$1" -map 0 -c:v copy -c:a ac3 -b:a 256K -ac 2 -c:s copy _.mp4
FFmpeg: Export SRT subtitle  # ffmpeg -i "$1" -map 0:s:0 _.srt
FFmpeg: Export SUP subtitle  # ffmpeg -i "$1" -map 0:s:0 -c:s copy _.sup
FFmpeg: Extract audio as MP3  # ffmpeg -i "$1" -vn -acodec libmp3lame -ab 192k -ar 44100 -y _.mp3
FFmpeg: Extract frame as poster  # ffmpeg -i "$1.mp4" -vframes 1 _poster.jpg
FFmpeg: Generate MP4 from autocast 1.  # autocast "$1.yaml" _.cast
FFmpeg: Generate MP4 from autocast 2.  # agg --theme asciinema --speed 1.5 --font-family "font: "Sarasa Mono SC" --font-size 14 --fps-cap 30 _.cast _.gif
FFmpeg: Generate MP4 from autocast 3.  # ffmpeg -i _.gif -movflags faststart -pix_fmt yuv420p -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" _.mp4
FFmpeg: Generate Video from image (1 sec duration)  # ffmpeg -loop 1 -i "$1" -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" -c:v libx264 -t 1 -pix_fmt yuv420p _.mp4
FFmpeg: Generate Video from image (1 sec per 30 images)  # ffmpeg -framerate 30 -i "$04d.png" -c:v libx264 -pix_fmt yuv420p _.mp4
FFmpeg: Generate Video from image (1 sec per image)  # ffmpeg -framerate 1 -i "$04d.png" -c:v libx264 -r 30 -pix_fmt yuv420p _.mp4
